############################
# VS Code workspace files  #
############################
.vscode/            # launch.json, settings.json, tasks.json, etc.

#################
# Build output  #
#################
# Maven
/target/

# Gradle
/build/
!gradle/wrapper/    # keep the wrapper JARs & properties

################################
# IntelliJ IDEA / JetBrains    #
################################
*.iml
.idea/

#####################
# Java byte‑code    #
#####################
*.class

#############
# Logging    #
#############
*.log

##########################
# IDE & tool meta files  #
##########################
# BlueJ
*.ctxt

# Eclipse / JDT LS (used by VS Code Java)
.project
.classpath
.settings/

# Mobile Tools for Java (J2ME)
.mtj.tmp/

########################
# Package archives     #
########################
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

#####################################
# JVM crash reports & heap dumps    #
#####################################
hs_err_pid*
replay_pid*
*.hprof

###############
# Terraform   #
###############
.terraform/
terraform.tfstate
terraform.tfstate.backup
terraform.tfvars
